# Easiest: run `make setup` (see docs/setup.md); it fills in everything below for you.
# Or copy to .env and fill in by hand. Never commit .env.

# Owner login
OWNER_EMAIL=you@example.com
# Generate with: make password   (format scrypt:<salt>:<hash>)
OWNER_PASSWORD_HASH=

# Random secrets. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
POSTGRES_PASSWORD=

LOG_LEVEL=INFO

# Encrypts the Gmail app password at rest (M11). Back it up; losing it means re-entering the app password.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# AI (reply analysis, research, personalization). Leave both keys empty to keep AI off.
# OpenRouter (default when its key is present): https://openrouter.ai/keys. Free models may log or train on inputs.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Gemini (second option, chosen in Settings): https://aistudio.google.com/apikey. Free tier: Google may use inputs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
